PORT=3001
HOST=127.0.0.1
DATA_DIR=./data
APP_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
# Production: set COOKIE_SECURE=true behind HTTPS, and APP_ORIGIN to the real domain.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
AI_CONCURRENCY=12
AI_TIMEOUT_MS=60000
# Optional, explicit local preview only. Production refuses DEMO_MODE=true.
DEMO_MODE=false
# Used by Docker Compose and Caddy on Alibaba Cloud.
DOMAIN=class.example.com
