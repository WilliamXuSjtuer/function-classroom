# Public browser URL, including a non-default HTTPS port if used. No trailing slash.
CLASSROOM_ORIGIN=https://classroom.william-ash.com
# Host loopback port for the existing reverse proxy; container port stays 3001.
CLASSROOM_PORT=1116

# Build-time base image for both Docker stages. Use an accessible official source.
# Docker's alternative registry: public.ecr.aws/docker/library/node:22-bookworm-slim
NODE_IMAGE=node:22-bookworm-slim

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
AI_CONCURRENCY=12
AI_TIMEOUT_MS=60000
