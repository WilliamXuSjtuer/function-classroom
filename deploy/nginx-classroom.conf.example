# Add a separate virtual host to the existing host Nginx configuration.
# Replace certificate paths with the actual certificate and private key paths.
server {
    listen 443 ssl;
    server_name classroom.william-ash.com;

    ssl_certificate /etc/nginx/ssl/classroom/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/classroom/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 10m;

    location / {
        proxy_pass http://127.0.0.1:1116;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 120s;
    }
}
